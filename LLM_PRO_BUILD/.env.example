# Nomos LLM 환경 설정 예시
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# === API URL (환경별) ===
# LLM_DEV_URL=http://dev.assistant.llm.skhynix.com/v1/chat/completions
# LLM_PROD_URL=http://summary.llm.skhynix.com/v1/chat/completions
# LLM_COMMON_URL=http://common.llm.skhynix.com/v1/chat/completions

# === 모델명 (환경별, 선택) ===
# LLM_DEV_MODEL=Qwen3-Coder-30B-A3B-Instruct
# LLM_PROD_MODEL=Qwen3-Next-80B-A3B-Instruct
# LLM_COMMON_MODEL=gpt-oss-20b
