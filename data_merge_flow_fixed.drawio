<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-12T10:00:00Z" agent="Demos Alpha 0.8" version="20.2.5" type="device">
  <diagram id="data-merge-flow" name="Data Merge Flow">
    <mxGraphModel dx="1244" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 시작 -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="260" y="30" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- CSV 로드 -->
        <mxCell id="load" value="Load CSV (try encodings: utf-8, cp949, euc-kr)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="100" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- 인코딩 시도 루프 -->
        <mxCell id="encDec" value="Encoding try / except" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E64A19;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="80" height="50" as="geometry"/>
        </mxCell>

        <!-- 컬럼 정리 -->
        <mxCell id="cleanCols" value="Clean columns&#xa;- strip whitespace&#xa;- remove '\r'&#xa;- drop Unnamed columns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="270" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- CRT_TM 정제 -->
        <mxCell id="cleanCRT" value="Trim CRT_TM column" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="380" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 통계 출력 -->
        <mxCell id="printStats" value="Print stats&#xa;- 원본 rows&#xa;- unique CRT_TM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4C3;strokeColor=#AFB42B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="460" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- 병합 (groupby) -->
        <mxCell id="merge" value="Group by CRT_TM&#xa;→ first() (keep first non-null row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#FF8F00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="560" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- 저장 -->
        <mxCell id="save" value="Save merged CSV (utf-8-sig)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#5E35B1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="660" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- 종료 -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFCDD2;strokeColor=#D32F2F;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="260" y="740" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- 연결선들 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="start" target="load">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="load" target="encDec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 인코딩 성공 -->
        <mxCell id="e3_success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#388E3C;" edge="1" parent="1" source="encDec" target="cleanCols">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Success 라벨 (root 직접 자식으로 분리) -->
        <mxCell id="label_success" value="Success" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="220" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- 인코딩 실패 (루프) -->
        <mxCell id="e3_fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D32F2F;dashed=1;" edge="1" parent="1" source="encDec" target="encDec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Fail 라벨 (root 직접 자식으로 분리) -->
        <mxCell id="label_fail" value="Fail → try next" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="195" width="80" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="cleanCols" target="cleanCRT">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="cleanCRT" target="printStats">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="printStats" target="merge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="merge" target="save">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#424242;" edge="1" parent="1" source="save" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
