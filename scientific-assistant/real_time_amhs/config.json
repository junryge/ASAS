      "upward_col": "BOTTLENECK_upward_anomaly_cols",
      "_dst_doc": "★CSV 에 저장될 이름 (접두어를 붙여 두 테이블을 구분)"
    },
    "queue": {
      "table": "ATLAS_QUEUE_ANOMALY",
      "time_col": "EVENT_DT",
      "src_downward": "downward_anomaly_cols",
      "src_upward": "upward_anomaly_cols",
      "downward_col": "QUEUE_downward_anomaly_cols",
      "upward_col": "QUEUE_upward_anomaly_cols"
    },
    "join_tolerance_s": 60,
    "_join_doc": "분 단위 데이터 기준. 같은 분으로 맞추고 못 찾으면 이 오차 내 최근접을 쓴다.",
    "target_columns": [
      "BOTTLENECK_downward_anomaly_cols",
      "BOTTLENECK_upward_anomaly_cols",
      "QUEUE_downward_anomaly_cols",
      "QUEUE_upward_anomaly_cols"
    ]
  },
