  "amos": {
    "_doc": "AMOS 이상감지 — ATLAS 2개 테이블의 downward/upward_anomaly_cols 를 각각 BOTTLENECK_/QUEUE_ 이름으로 바꿔 기본 데이터에 시각으로 붙인다.",
    "_확인방법": "python lp_query.py --schema -t ATLAS_BOTTLENECK_ANOMALY   ← 실제 컬럼 확인 후 *_col 교체",
    "source": "atlas_tables",
    "filter": "MCP_NM == \"BR\"",
